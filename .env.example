# Cloudland Docker Environment Configuration
# Copy this file to .env and update the values

# === Database ===
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cloudland
DB_USER=cloudland_user
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# === Backend ===
PORT=3000
NODE_ENV=production

# === Microservice JWT ===
MICROSERVICE_AUTH_URL=http://auth:4002
MICROSERVICE_JWT_SECRET=CHANGE_THIS_SECRET
MICROSERVICE_JWT_ALGORITHM=HS256
MICROSERVICE_JWT_ISSUER=APM_jwt
MICROSERVICE_JWT_AUDIENCE=ailand.ai

# === FusionAuth ===
FUSIONAUTH_BASE_URL=https://auth.ailand.ai
FUSIONAUTH_API_KEY=YOUR_FUSIONAUTH_API_KEY
FUSIONAUTH_APPLICATION_ID=YOUR_APP_ID

# === Optional "extra" profile services (storage / background-task) ===
STORAGE_DATABASE_URL=postgresql+asyncpg://cloudland_user:CHANGE_ME@postgres:5432/cloudland
BACKGROUND_TASK_DATABASE_URL=postgresql+asyncpg://cloudland_user:CHANGE_ME@postgres:5432/cloudland
