  "main": "index.js",
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd api/backend && python -m uvicorn app.main:app --reload --port 3000",
    "dev:frontend": "cd style/frontend && npx quasar dev",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd api/backend && python -m unittest discover tests",
    "test:frontend": "cd style/frontend && npm test"
  },
